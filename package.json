{
  "name": "onboarding-workspace",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "dependencies": {
    "@onboarding/design-tokens": "workspace:*",
    "@onboarding/ui-primitives": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @onboarding/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "smoke:ci": "pnpm --filter @onboarding/web run smoke:ci"
  }
}
